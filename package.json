{
    "name": "@diia-inhouse/providers",
    "version": "2.6.59",
    "description": "common providers",
    "license": null,
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-providers",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "prebuild": "rimraf dist",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "start": "npm run build && node dist/index.js",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "dependencies": {
        "@diia-inhouse/diia-logger": "4.7.12",
        "@diia-inhouse/diia-queue": "14.2.34",
        "@diia-inhouse/errors": "2.3.20",
        "@diia-inhouse/types": "14.5.3",
        "@diia-inhouse/utils": "6.1.21",
        "@diia-inhouse/validators": "2.2.108",
        "lodash": "4.18.1",
        "math-expression-evaluator": "2.0.7",
        "type-fest": "5.6.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.2.2",
        "@diia-inhouse/oxc-config": "4.0.2",
        "@diia-inhouse/test": "8.3.37",
        "@types/lodash": "4.17.24",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11",
        "vitest-mock-extended": "4.0.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
